{
  "name": "devlog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fast, statically generated developer blog: MDX posts with syntax highlighting, tags, RSS, sitemap and social metadata.",
  "license": "MIT",
  "author": "Raymond Pingol Blanco Jr. (https://www.kirisen.xyz)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "new": "node scripts/new-post.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
